# Environment configuration for AI Project Execution Platform

# Database configuration
DATABASE_URL=postgresql://user:password@postgres:5432/projectdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=projectdb

# MinIO configuration (object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Ollama configuration - should be adjusted for your network setup
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_PLANNER_MODEL=qwen3:8b
OLLAMA_CODER_MODEL=qwen3-coder:30b
OLLAMA_REVIEWER_MODEL=qwen3:8b
OLLAMA_FAST_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=minicpm-v:latest
OLLAMA_API_TOKEN=<secret>

# Temporal (workflow) configuration
TEMPORAL_ADDRESS=temporal:7233

# Model gateway configuration  
MODEL_GATEWAY_PORT=8080

# Sandbox controller configuration
SANDBOX_TIMEOUT=300

# OpenTelemetry configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Development settings
DEBUG=true
LOG_LEVEL=INFO

# TLS certificate paths (when needed)
TLS_CERT_PATH=/certs/cert.pem
TLS_KEY_PATH=/certs/key.pem

# Container image definitions  
AGENT_WORKER_IMAGE=agent-worker:latest
ORCHESTRATOR_WORKER_IMAGE=orchestrator-worker:latest
REVIEW_WORKER_IMAGE=review-worker:latest
