APP_PORT=8088
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=orchestrator

# Remote Ollama or its TLS/authenticated reverse proxy. Include /v1.
OLLAMA_BASE_URL=http://192.168.1.50:11434/v1
OLLAMA_API_TOKEN=ollama
MODEL_GATEWAY_TOKEN=replace-with-an-internal-token
MODEL_TIMEOUT_SECONDS=600
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_MAX_CONCURRENCY=2
SANDBOX_TOKEN=replace-with-an-internal-sandbox-token
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_OUTPUT_BYTES=200000

# Logical model aliases. These models must be installed on the remote Ollama host.
OLLAMA_PLANNER_MODEL=qwen3:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_REVIEWER_MODEL=qwen3:8b
OLLAMA_FAST_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=qwen3-vl:8b

GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
